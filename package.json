{
  "name": "agente-oc-periferia",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun run src/server.ts",
    "demo": "bun run demo.ts",
    "test": "bun test",
    "test:container": "bash scripts/smoke-container.sh",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run demo",
    "doctor": "bun scripts/doctor.ts",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "google-auth-library": "10.9.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "pdf-lib": "1.17.1",
    "zod": "4.6.5"
  }
}
