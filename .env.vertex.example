# Copiar a .env. No contiene credenciales ni identifica un proyecto real.
LLM_PROVIDER=vertex
VERTEX_AUTH_MODE=adc
GOOGLE_CLOUD_PROJECT=tu-proyecto-autorizado
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite

# Desarrollo local: gcloud auth application-default login
# Alternativa: ruta ABSOLUTA a una cuenta de servicio fuera del repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/cuenta-servicio.json
# En Cloud Run se usa la identidad de la cuenta de servicio asignada.
# Para una API key de Vertex Express, seleccionar VERTEX_AUTH_MODE=api-key
# y configurar VERTEX_API_KEY. No se utiliza la API key de Gemini AI Studio.

LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=3
MAX_ITERACIONES=8
MAX_TOKENS_POR_SESION=2000000
MAX_COSTO_USD_POR_SESION=5
# Completar con la tarifa vigente del modelo; referencias históricas 0.1/0.4.
PRECIO_ENTRADA_USD_POR_MILLON=
PRECIO_SALIDA_USD_POR_MILLON=
USUARIO_CONFIRMADOR=analista
PORT=3000
